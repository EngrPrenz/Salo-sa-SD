{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "cleanup-duplicate-tables.js",
      "fix-tables-assignedto.html",
      "firebase-debug.log"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/waiter-login.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      }
    ]
  }
}
